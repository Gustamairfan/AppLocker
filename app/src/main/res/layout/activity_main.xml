<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App Locker"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Batas Waktu Penggunaan (Off Timer)"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerOff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Waktu Kunci (Wait Time)"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerWait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="AKTIFKAN"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Target: YouTube, Facebook, TikTok\nPIN default: 1234"
        android:textAlignment="center"
        android:textSize="14sp" />

    <!-- Spacer supaya copyright di paling bawah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Created By : irfan Gustama"
        android:textSize="12sp"
        android:textColor="#888888"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

</LinearLayout>
